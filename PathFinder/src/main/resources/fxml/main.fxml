<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<AnchorPane id="AnchorPane"
            fx:controller="com.mycompany.pathfinder.MainController"
            prefHeight="700.0"
            prefWidth="1200.0"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/26">

    <children>

        <HBox layoutX="40.0"
              layoutY="30.0"
              prefHeight="620.0"
              prefWidth="1120.0"
              spacing="30.0">

            <children>

                <!-- ========================= -->
                <!-- GRILLE                     -->
                <!-- ========================= -->

                <VBox prefHeight="620.0"
                      prefWidth="700.0"
                      spacing="20.0">

                    <children>

                        <Label text="Visualisation des algorithmes">
                            <font>
                                <Font name="System Bold" size="24.0"/>
                            </font>
                        </Label>

                        <GridPane fx:id="gridPane"
                                  prefHeight="480.0"
                                  prefWidth="650.0"
                                  style="-fx-border-color: #cccccc; -fx-border-width: 1;"/>

                        <!-- ========================= -->
                        <!-- LEGENDE                     -->
                        <!-- ========================= -->

                        <HBox spacing="18.0">

                            <children>

                                <Label text="S  Départ"
                                       textFill="GREEN">
                                    <font>
                                        <Font name="System Bold" size="13.0"/>
                                    </font>
                                </Label>

                                <Label text="A  Arrivée"
                                       textFill="RED">
                                    <font>
                                        <Font name="System Bold" size="13.0"/>
                                    </font>
                                </Label>

                                <Label text="■  Mur"
                                       textFill="DARKGRAY"/>

                                <Label text="■  BFS"
                                       textFill="BLUE">
                                    <font>
                                        <Font name="System Bold" size="12.0"/>
                                    </font>
                                </Label>

                                <Label text="■  DFS"
                                       textFill="GREEN">
                                    <font>
                                        <Font name="System Bold" size="12.0"/>
                                    </font>
                                </Label>

                                <Label text="■  Dijkstra"
                                       textFill="PURPLE">
                                    <font>
                                        <Font name="System Bold" size="12.0"/>
                                    </font>
                                </Label>

                                <Label text="■  A*"
                                       textFill="ORANGE">
                                    <font>
                                        <Font name="System Bold" size="12.0"/>
                                    </font>
                                </Label>

                            </children>

                        </HBox>

                    </children>

                </VBox>


                <!-- ========================= -->
                <!-- CONTROLES                   -->
                <!-- ========================= -->

                <VBox prefHeight="620.0"
                      prefWidth="390.0"
                      spacing="15.0">

                    <padding>
                        <Insets bottom="10.0"
                                left="10.0"
                                right="10.0"
                                top="5.0"/>
                    </padding>

                    <children>

                        <Label text="Contrôles">
                            <font>
                                <Font name="System Bold" size="24.0"/>
                            </font>
                        </Label>


                        <!-- ALGORITHME -->

                        <Label text="Algorithme">
                            <font>
                                <Font size="15.0"/>
                            </font>
                        </Label>

                        <ComboBox fx:id="algorithmComboBox"
                                  prefHeight="40.0"
                                  prefWidth="350.0"/>


                        <!-- DEPART / ARRIVEE -->

                        <Button fx:id="positionButton"
                                mnemonicParsing="false"
                                prefHeight="40.0"
                                prefWidth="335.0"
                                text="Placer départ / arrivée">

                            <font>
                                <Font size="14.0"/>
                            </font>

                        </Button>


                        <!-- LANCER / RESET -->

                        <HBox spacing="15.0">

                            <children>

                                <Button fx:id="launchButton"
                                        mnemonicParsing="false"
                                        prefHeight="45.0"
                                        prefWidth="160.0"
                                        text="Lancer">

                                    <font>
                                        <Font size="15.0"/>
                                    </font>

                                </Button>


                                <Button fx:id="resetButton"
                                        mnemonicParsing="false"
                                        prefHeight="45.0"
                                        prefWidth="160.0"
                                        text="Réinitialiser">

                                    <font>
                                        <Font size="15.0"/>
                                    </font>

                                </Button>

                            </children>

                        </HBox>


                        <!-- ========================= -->
                        <!-- NOUVEAU BOUTON             -->
                        <!-- ========================= -->

                        <Button fx:id="compareButton"
                                mnemonicParsing="false"
                                prefHeight="45.0"
                                prefWidth="335.0"
                                text="Lancer les 4 algorithmes">

                            <font>
                                <Font name="System Bold"
                                      size="14.0"/>
                            </font>

                        </Button>


                        <Separator prefWidth="350.0"/>


                        <!-- ========================= -->
                        <!-- RESULTATS                   -->
                        <!-- ========================= -->

                        <Label text="Résultats">
                            <font>
                                <Font name="System Bold"
                                      size="21.0"/>
                            </font>
                        </Label>


                        <TableView fx:id="resultTable"
                                    prefWidth="370.0"
                                    minWidth="370.0"
                                    maxWidth="370.0"
                                    prefHeight="145.0"
                                    minHeight="145.0"
                                    maxHeight="145.0">

                             <columns>

                                 <TableColumn fx:id="rankColumn"
                                              text="Rang"/>

                                 <TableColumn fx:id="algorithmColumn"
                                              text="Algorithme"/>

                                 <TableColumn fx:id="exploredColumn"
                                              text="Explorées"/>

                                 <TableColumn fx:id="pathColumn"
                                              text="Chemin"/>

                                 <TableColumn fx:id="timeColumn"
                                              text="Temps exécution"/>

                             </columns>

                         </TableView>

                    </children>

                </VBox>

            </children>

        </HBox>

    </children>

</AnchorPane>
